from confluent_kafka import Consumer


config = {
    "bootstrap.servers": "https://meowmetry-kafka.dev1.mnt.group",
    "group.id": "telemetry-transport-lab",
    "auto.offset.reset": "latest",

}

consumer = Consumer(config)

consumer.subscribe(["signals"])


while True:
    message = consumer.poll(5.0)

    if message is None:
        print("No messages found")
        continue

    if message.error():
        print(message.error())
        continue

    print(message.value())





